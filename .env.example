# Copie para .env.local e preencha. O .env.local nao vai para o git.

# Postgres do Neon. Painel do Neon > Connection string > "pooled".
DATABASE_URL=

# Segredo que assina o cookie de sessao. Gere um novo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSAO_SEGREDO=

# Entrada pelo Google. Opcional: sem estas duas, o botao do Google
# simplesmente nao aparece e o cadastro por e-mail continua funcionando.
# Como obter, no console.cloud.google.com:
#   1. Crie um projeto
#   2. APIs e servicos > Tela de permissao OAuth > Externo > preencha nome e e-mail
#   3. Credenciais > Criar credenciais > ID do cliente OAuth > Aplicativo da Web
#   4. Em "URIs de redirecionamento autorizados", acrescente as duas:
#        https://ominisounds.vercel.app/api/auth/google/callback
#        http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mercado Pago Checkout Pro. O site cria preferencias de pagamento e redireciona
# o comprador para o checkout hospedado, sem coletar cartao no OMINSOUNDS.
MERCADO_PAGO_ACCESS_TOKEN=

# Segredo do webhook em Mercado Pago > Suas integracoes > Webhooks.
# Recomendado em producao para validar x-signature/x-request-id.
MERCADO_PAGO_WEBHOOK_SECRET=

# URL publica usada em back_urls e notification_url.
NEXT_PUBLIC_SITE_URL=https://ominisounds.vercel.app
